[
  {
    "doctype": "Custom Field",
    "name": "Issue-synthetic_reference",
    "dt": "Issue",
    "fieldname": "synthetic_reference",
    "fieldtype": "Data",
    "label": "Synthetic Reference"
  },
  {
    "doctype": "Custom Field",
    "name": "Lead-expected_deal_value",
    "dt": "Lead",
    "fieldname": "expected_deal_value",
    "fieldtype": "Currency",
    "label": "Expected Deal Value",
    "insert_after": "annual_revenue"
  },
  {
    "doctype": "Custom Field",
    "name": "Lead-estimated_value",
    "dt": "Lead",
    "fieldname": "estimated_value",
    "fieldtype": "Currency",
    "label": "Estimated Value",
    "insert_after": "expected_deal_value",
    "description": "Estimated potential value of this customer/lead, entered when the lead is created."
  },
  {
    "doctype": "Custom Field",
    "name": "Customer-customer_classification",
    "dt": "Customer",
    "fieldname": "customer_classification",
    "fieldtype": "Select",
    "label": "Customer Classification",
    "options": "Normal\nVIP\nHigh Risk",
    "default": "Normal",
    "insert_after": "customer_group"
  },
  {
    "doctype": "Custom Field",
    "name": "Item-important_item",
    "dt": "Item",
    "fieldname": "important_item",
    "fieldtype": "Check",
    "label": "Important Item",
    "insert_after": "is_stock_item",
    "default": "0",
    "description": "When checked, the Purchase Manager is automatically alerted if this item's stock falls below 10."
  }
]
