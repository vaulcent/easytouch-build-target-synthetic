[
  {
    "doctype": "Custom Field",
    "name": "Issue-synthetic_reference",
    "dt": "Issue",
    "fieldname": "synthetic_reference",
    "fieldtype": "Data",
    "label": "Synthetic Reference"
  },
  {
    "doctype": "Custom Field",
    "name": "Lead-referral_source",
    "dt": "Lead",
    "fieldname": "referral_source",
    "fieldtype": "Select",
    "label": "Referral Source",
    "options": "Website\nReferral\nCold Call",
    "insert_after": "source"
  },
  {
    "doctype": "Custom Field",
    "name": "Lead-potential_value",
    "dt": "Lead",
    "fieldname": "potential_value",
    "fieldtype": "Currency",
    "label": "Potential Value",
    "insert_after": "annual_revenue",
    "description": "Estimated worth of this lead if converted to a customer."
  },
  {
    "doctype": "Custom Field",
    "name": "Customer-risk_classification",
    "dt": "Customer",
    "fieldname": "risk_classification",
    "fieldtype": "Select",
    "label": "Risk Classification",
    "options": "Normal\nVIP\nHigh Risk",
    "default": "Normal",
    "insert_after": "customer_group",
    "description": "Team-assigned classification: Normal, VIP, or High Risk."
  },
  {
    "doctype": "Custom Field",
    "name": "Task-priority_tier",
    "dt": "Task",
    "fieldname": "priority_tier",
    "fieldtype": "Select",
    "label": "Priority Tier",
    "options": "Low\nMedium\nHigh",
    "insert_after": "priority"
  },
  {
    "doctype": "Custom Field",
    "name": "Opportunity-release_pipeline_proof",
    "dt": "Opportunity",
    "fieldname": "release_pipeline_proof",
    "fieldtype": "Small Text",
    "label": "Release Pipeline Proof",
    "insert_after": "title",
    "description": "Used only to prove the release validation/promotion pipeline end to end."
  },
  {
    "doctype": "Custom Field",
    "name": "Item-is_important_item",
    "dt": "Item",
    "fieldname": "is_important_item",
    "fieldtype": "Check",
    "label": "Is Important Item",
    "insert_after": "item_group",
    "default": "0",
    "description": "Marks this item as important so the Low Stock Alert for Important Items notification applies when its stock quantity drops below 10."
  }
]
