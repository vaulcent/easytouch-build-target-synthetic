        "condition": "doc.additional_discount_percentage <= 10"
      },
      {
        "state": "Draft",
        "action": "Send for Approval",
        "next_state": "Pending Manager Approval",
        "allowed": "Sales User",
        "allow_self_approval": 1,
        "condition": "doc.additional_discount_percentage > 10"
      },
      {
        "state": "Pending Manager Approval",
        "action": "Approve",
        "next_state": "Approved",
        "allowed": "Sales Manager",
        "allow_self_approval": 0,
        "condition": "doc.additional_discount_percentage > 10"
      }
    ]
  },
